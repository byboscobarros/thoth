# Thoth local environment example

# Runtime
THOTH_PREFERRED_PROVIDER=mock
THOTH_SESSION_STORE=inmemory
# THOTH_SESSION_DIR=.thoth/sessions

# Session compaction (Layer 3)
THOTH_SESSION_ACTIVE_WINDOW=40
THOTH_SESSION_COMPACTION_THRESHOLD=20
THOTH_PROVIDER_CONTEXT_LIMIT=40
THOTH_SESSION_MAX_SUMMARY_CHARS=1200
THOTH_SESSION_SUMMARIZER=heuristic
# THOTH_SESSION_SUMMARIZER_PROVIDER=mock
# THOTH_SESSION_SUMMARIZER_MODEL=openai/gpt-5.2

# OpenRouter provider
# THOTH_OPENROUTER_API_KEY=
THOTH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
THOTH_OPENROUTER_MODEL=openai/gpt-5.2
# THOTH_OPENROUTER_HTTP_REFERER=
# THOTH_OPENROUTER_TITLE=
THOTH_OPENROUTER_TIMEOUT_SECONDS=60
